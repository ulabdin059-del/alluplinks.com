# Copy to .env for local production-like runs (npm run start:prod). On Render, enter these in
# Dashboard → alluplinks → Environment. Never commit real values.

# --- Required in production ---
NODE_ENV=production
# Turso: `turso db show alluplinks --url` and `turso db tokens create alluplinks`
TURSO_DATABASE_URL=libsql://alluplinks-yourname.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=
# Cloudinary: Dashboard → "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# First admin account (created once, on first start against an empty database)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Long random string; Render generates this automatically from render.yaml
JWT_SECRET=

# --- Email (recommended: Brevo, free 300 emails/day, works on Render free) ---
BREVO_API_KEY=
# Must be a sender address verified in Brevo
MAIL_FROM=All Uplinks <you@example.com>
# Where new booking / trade-in / inquiry alerts go
ADMIN_NOTIFY_EMAIL=you@example.com

# --- Optional ---
# RESEND_API_KEY=            # alternative email provider (needs a verified domain)
# SMTP_HOST= SMTP_PORT=587 SMTP_SECURE=false SMTP_USER= SMTP_PASS=   # SMTP (not usable on Render free)
# CLOUDINARY_FOLDER=alluplinks
# ADMIN_RESET_PASSWORD=true  # one-time: resets ADMIN_EMAIL's password to ADMIN_PASSWORD on start, then remove
# PORT=3001
# DATA_DIR=./storage         # local database/uploads folder when Turso/Cloudinary are not set
