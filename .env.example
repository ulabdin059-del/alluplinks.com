# Copy to .env for local production-like runs (npm run start:prod). On a host, enter these in its dashboard
# (Hostinger: Websites → your Node.js app → Environment variables; Render: Dashboard → Environment).
# Never commit real values. Full Hostinger steps: HOSTINGER.md

# --- Required in production ---
NODE_ENV=production

# Database — choose ONE (with none set, a local SQLite file in DATA_DIR is used):
# (a) MySQL / MariaDB, e.g. Hostinger hPanel → Databases → MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_SSL=true                # only if a remote MySQL server requires TLS
# (b) Turso: `turso db show alluplinks --url` and `turso db tokens create alluplinks`
# TURSO_DATABASE_URL=libsql://alluplinks-yourname.aws-us-east-1.turso.io
# TURSO_AUTH_TOKEN=
# Cloudinary: Dashboard → "API environment variable"
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# First admin account (created once, on first start against an empty database)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Long random string; Render generates this automatically from render.yaml
JWT_SECRET=

# --- Email ---
# Hostinger mailbox (SMTP works on Hostinger):
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@alluplinks.com
SMTP_PASS=
MAIL_FROM=All Uplinks <info@alluplinks.com>
# Where new booking / trade-in / inquiry alerts go
ADMIN_NOTIFY_EMAIL=you@example.com
# On hosts that block SMTP (e.g. Render free) use Brevo instead: BREVO_API_KEY= (sender verified in Brevo)

# --- Optional ---
# RESEND_API_KEY=            # alternative email provider (needs a verified domain)
# CALLMEBOT_API_KEY=         # WhatsApp alerts for new bookings/trade-ins/messages (free key from callmebot.com)
# WHATSAPP_NOTIFY_PHONE=+19055359503   # defaults to the store phone in Site settings
# ALLOW_RESTORE=true         # only while moving hosts: shows Admin → Site settings → Restore from backup
# CLOUDINARY_FOLDER=alluplinks
# ADMIN_RESET_PASSWORD=true  # one-time: resets ADMIN_EMAIL's password to ADMIN_PASSWORD on start, then remove
# PORT=3001
# DATA_DIR=./storage         # local database/uploads folder when no database/Cloudinary is set
